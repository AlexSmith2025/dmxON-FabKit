// fk_draw.ulp — геометрия платы и чертежи сборки (SVG): контур, корпуса, площадки, ключи, шаги пайки
// dmxON FabKit · dmxON by AlexSmith 2026 · см. LICENSE.md

// ---------------------------------------------------------------- контур платы

string ol_path = "";          // контур платы (слой 20), координаты платы в мм
string ol_circ = "";          // круглые вырезы
real bb_x1 = 0, bb_y1 = 0, bb_x2 = 0, bb_y2 = 0;
int bb_set = 0;

void bb_add(real x, real y)
{
    if (!bb_set) { bb_x1 = x; bb_x2 = x; bb_y1 = y; bb_y2 = y; bb_set = 1; return; }
    if (x < bb_x1) bb_x1 = x;
    if (x > bb_x2) bb_x2 = x;
    if (y < bb_y1) bb_y1 = y;
    if (y > bb_y2) bb_y2 = y;
}

// отрезок или дуга в формате SVG path (координаты в мм, ось Y вверх)
string seg_path(real x1, real y1, real x2, real y2, real curve)
{
    string s;
    if (curve == 0) {
        sprintf(s, "M%s %sL%s %s", f3(x1), f3(y1), f3(x2), f3(y2));
        return s;
    }
    real ch = sqrt((x2 - x1) * (x2 - x1) + (y2 - y1) * (y2 - y1));
    real a = curve;
    if (a < 0) a = -a;
    real r = ch / (2 * sin(a * PI_ / 360.0));
    int large = (a > 180);
    int sweep = (curve > 0);
    sprintf(s, "M%s %sA%s %s 0 %d %d %s %s", f3(x1), f3(y1), f3(r), f3(r), large, sweep, f3(x2), f3(y2));
    return s;
}

// ---------------------------------------------------------------- элементы

string el_gfx[];              // графика корпуса (tPlace/tDocu): path d
string el_circ[];             // окружности корпуса: готовые <circle>
string el_pads[];             // площадки: готовые SVG-элементы (координаты платы)
real el_p1x[], el_p1y[];      // вывод 1 (или катод) на плате
int el_has_p1[], el_p1cat[];  // есть ли ключ; 1 = это катод
real el_bx1[], el_by1[], el_bx2[], el_by2[];
real el_pitch[];              // минимальный шаг выводов, мм
int el_npads[];

void el_bb_add(int e, real x, real y)
{
    if (x < el_bx1[e]) el_bx1[e] = x;
    if (x > el_bx2[e]) el_bx2[e] = x;
    if (y < el_by1[e]) el_by1[e] = y;
    if (y > el_by2[e]) el_by2[e] = y;
}

void el_draw_init(int e)
{
    el_gfx[e] = ""; el_circ[e] = ""; el_pads[e] = "";
    el_has_p1[e] = 0; el_p1cat[e] = 0; el_p1x[e] = 0; el_p1y[e] = 0;
    el_bx1[e] = 1000000.0; el_by1[e] = 1000000.0; el_bx2[e] = -1000000.0; el_by2[e] = -1000000.0;
    el_pitch[e] = 0; el_npads[e] = 0;
}

// площадка в SVG (координаты платы)
string pad_svg(real x, real y, real w, real hh, real rot, int rnd)
{
    string s;
    if (rnd) sprintf(s, "<circle cx=\"%s\" cy=\"%s\" r=\"%s\"/>", f3(x), f3(y), f3(w / 2));
    else sprintf(s, "<rect x=\"%s\" y=\"%s\" width=\"%s\" height=\"%s\" transform=\"translate(%s %s) rotate(%s)\"/>",
                 f3(-w / 2), f3(-hh / 2), f3(w), f3(hh), f3(x), f3(y), f3(rot));
    return s;
}

// катод диода/светодиода: площадка с таким именем
int is_cathode_name(string n)
{
    n = strupr(trim(n));
    return n == "C" || n == "K" || n == "KA" || n == "CATHODE" || n == "-";
}

// ---------------------------------------------------------------- шаги пайки

int STEP_N = 7;

string step_ru(int s)
{
    if (s == 1) return "Нижняя сторона: SMD-компоненты";
    if (s == 2) return "Микросхемы с мелким шагом (QFN, QFP, шаг ≤ 0.65 мм)";
    if (s == 3) return "Прочие микросхемы и транзисторы (SOIC, SOT, TSSOP)";
    if (s == 4) return "Мелкие пассивные компоненты (0201–0805)";
    if (s == 5) return "Остальные SMD: 1206+, диоды, светодиоды, кварцы";
    if (s == 6) return "Крупные SMD: электролиты, силовые дроссели, SMD-разъёмы";
    return "Выводные компоненты (THT) — в последнюю очередь";
}

string step_en(int s)
{
    if (s == 1) return "Bottom side: SMD parts";
    if (s == 2) return "Fine-pitch ICs (QFN, QFP, pitch ≤ 0.65 mm)";
    if (s == 3) return "Other ICs and transistors (SOIC, SOT, TSSOP)";
    if (s == 4) return "Small passives (0201–0805)";
    if (s == 5) return "Other SMD: 1206+, diodes, LEDs, crystals";
    if (s == 6) return "Bulky SMD: electrolytics, power inductors, SMD connectors";
    return "Through-hole parts (THT) — last";
}

string step_tip_ru(int s)
{
    if (s == 1) return "Паяйте первой сторону с меньшим числом и массой деталей.";
    if (s == 2) return "Флюс, паяльная паста или волна по выводам; проверить мосты под лупой. Центральную площадку — феном.";
    if (s == 3) return "Сначала прихватить один вывод, выровнять по ключу, затем пропаять остальные.";
    if (s == 4) return "Пинцет и тонкое жало; одна сторона — прихват, затем вторая.";
    if (s == 5) return "Соблюдать полярность диодов и светодиодов (метка катода).";
    if (s == 6) return "Учесть теплоёмкость: прогрев сильнее, полярность электролитов.";
    return "Выводные — последними, после отмывки SMD; низкие раньше высоких.";
}

string step_tip_en(int s)
{
    if (s == 1) return "Solder the side with fewer and lighter parts first.";
    if (s == 2) return "Flux and paste or drag-solder; inspect for bridges. Exposed pad — hot air.";
    if (s == 3) return "Tack one pin, align to the pin-1 key, then solder the rest.";
    if (s == 4) return "Tweezers and a fine tip; tack one side, then the other.";
    if (s == 5) return "Mind diode and LED polarity (cathode mark).";
    if (s == 6) return "Large thermal mass: more heat; electrolytic polarity.";
    return "THT parts last, after cleaning SMD; low parts before tall ones.";
}

int el_step[];

int calc_step(int e)
{
    if (el_bottom[e] && !el_tht[e]) return 1;
    if (el_tht[e]) return 7;
    string p = des_prefix(el_name[e]);
    real w = el_bx2[e] - el_bx1[e], hh = el_by2[e] - el_by1[e];
    real area = w * hh;
    int ic = (p == "U" || p == "IC" || p == "DA" || p == "DD" || p == "Q" || p == "VT" || p == "T" || p == "VR");
    if (el_npads[e] >= 8 && el_pitch[e] > 0 && el_pitch[e] <= 0.66) return 2;
    if (ic || el_npads[e] >= 3) {
        if (area > 60) return 6;
        return 3;
    }
    if (el_npads[e] <= 2 && (p == "R" || p == "C" || p == "L" || p == "FB")) {
        string j = el_jpkg[e];
        if (j == "01005" || j == "0201" || j == "0402" || j == "0603" || j == "0805") return 4;
    }
    if (area > 30) return 6;
    return 5;
}

// ---------------------------------------------------------------- чертёж стороны

// размер подписей в мм платы: отчёт на экране и чертёж в масштабе задают свои пределы
real ds_fsmin = 0.55, ds_fsmax = 2.2;
string ds_wh = "";            // размер чертежа в мм (style), если пусто — в пикселях

// sel: строка вида "|R1|C5|" — выделенные элементы; "" = ничего не выделять
// labels: 0 = подписи только выделенных, 1 = подписи всех
string draw_side(int bottom, string sel, int labels, int pxw)
{
    real mg = 3.0;
    real x0 = bb_x1 - mg, x1 = bb_x2 + mg, y0 = bb_y1 - mg, y1 = bb_y2 + mg;
    real W = x1 - x0, H = y1 - y0;
    int pxh = int(pxw * H / W);
    string s, t, tr;
    // сверху: Y вверх -> вниз; снизу: ещё и зеркало по X (вид со стороны пайки)
    if (bottom) sprintf(tr, "matrix(-1 0 0 -1 %s %s)", f3(x1), f3(y1));
    else sprintf(tr, "matrix(1 0 0 -1 %s %s)", f3(-x0), f3(y1));
    if (ds_wh != "") sprintf(s, "<svg class=\"brd\" viewBox=\"0 0 %s %s\" style=\"%s\" xmlns=\"http://www.w3.org/2000/svg\">", f3(W), f3(H), ds_wh);
    else sprintf(s, "<svg class=\"brd\" viewBox=\"0 0 %s %s\" width=\"%d\" height=\"%d\" xmlns=\"http://www.w3.org/2000/svg\">",
                 f3(W), f3(H), pxw, pxh);
    s += "<g transform=\"" + tr + "\">";
    s += "<path class=\"ol\" d=\"" + ol_path + "\"/>" + ol_circ;
    int e;
    // сначала невыделенные (бледно), затем выделенные
    for (int pass = 0; pass < 2; pass++) {
        for (e = 0; e < n_el; e++) {
            if (el_bottom[e] != bottom && !el_tht[e]) continue;
            if (el_bottom[e] != bottom && el_tht[e]) {
                // выводная с другой стороны видна только площадками
                if (pass == 0) s += "<g class=\"pd0\">" + el_pads[e] + "</g>";
                continue;
            }
            int hi = (sel != "" && strstr(sel, "|" + el_name[e] + "|") >= 0);
            if (pass == 0 && hi) continue;
            if (pass == 1 && !hi) continue;
            string cls = "e0";
            if (hi) cls = "e1";
            else if (sel == "") cls = "e2";
            s += "<g class=\"" + cls + "\"><g class=\"pd\">" + el_pads[e] + "</g>";
            if (el_gfx[e] != "") s += "<path class=\"gx\" d=\"" + el_gfx[e] + "\"/>";
            s += el_circ[e] + "</g>";
        }
    }
    // ключи: вывод 1 / катод
    for (e = 0; e < n_el; e++) {
        if (el_bottom[e] != bottom || !el_has_p1[e]) continue;
        int hi = (sel == "" || strstr(sel, "|" + el_name[e] + "|") >= 0);
        if (!hi) continue;
        real r = 0.35;
        if (el_bx2[e] - el_bx1[e] > 6) r = 0.55;
        sprintf(t, "<circle class=\"k1\" cx=\"%s\" cy=\"%s\" r=\"%s\"/>", f3(el_p1x[e]), f3(el_p1y[e]), f3(r));
        s += t;
    }
    s += "</g>";
    // подписи (вне трансформации, чтобы текст не зеркалился)
    for (e = 0; e < n_el; e++) {
        if (el_bottom[e] != bottom) continue;
        int hi = (sel != "" && strstr(sel, "|" + el_name[e] + "|") >= 0);
        if (!labels && !hi) continue;
        real cx = (el_bx1[e] + el_bx2[e]) / 2, cy = (el_by1[e] + el_by2[e]) / 2;
        real sx, sy;
        if (bottom) sx = x1 - cx;
        else sx = cx - x0;
        sy = y1 - cy;
        real bw = el_bx2[e] - el_bx1[e], bh = el_by2[e] - el_by1[e];
        real fs = min(bw, bh) * 0.55;
        if (fs < ds_fsmin) fs = ds_fsmin;
        if (fs > ds_fsmax) fs = ds_fsmax;
        if (hi) fs = fs * 1.15;
        string lc = "lb";
        if (hi) lc = "lb1";
        else if (sel != "") lc = "lb0";
        sprintf(t, "<text class=\"%s\" x=\"%s\" y=\"%s\" font-size=\"%s\">%s</text>", lc, f3(sx), f3(sy + fs * 0.35), f3(fs), h(el_name[e]));
        s += t;
    }
    s += "</svg>";
    return s;
}

// ключ микросхемы словами: где вывод 1 относительно центра корпуса (вид сверху)
string key_where_ru(int e)
{
    if (!el_has_p1[e]) return "";
    real cx = (el_bx1[e] + el_bx2[e]) / 2, cy = (el_by1[e] + el_by2[e]) / 2;
    real dx = el_p1x[e] - cx, dy = el_p1y[e] - cy;
    if (el_bottom[e]) dx = -dx;                      // вид со стороны пайки
    string v = "", g = "";
    real w = (el_bx2[e] - el_bx1[e]) / 2, hh = (el_by2[e] - el_by1[e]) / 2;
    if (dy > hh * 0.25) v = "сверху";
    else if (dy < -hh * 0.25) v = "снизу";
    if (dx > w * 0.25) g = "справа";
    else if (dx < -w * 0.25) g = "слева";
    string s = g;
    if (v != "") { if (s != "") s += " "; s += v; }
    if (s == "") s = "в центре";
    return s;
}

string key_where_en(int e)
{
    if (!el_has_p1[e]) return "";
    real cx = (el_bx1[e] + el_bx2[e]) / 2, cy = (el_by1[e] + el_by2[e]) / 2;
    real dx = el_p1x[e] - cx, dy = el_p1y[e] - cy;
    if (el_bottom[e]) dx = -dx;
    string v = "", g = "";
    real w = (el_bx2[e] - el_bx1[e]) / 2, hh = (el_by2[e] - el_by1[e]) / 2;
    if (dy > hh * 0.25) v = "top";
    else if (dy < -hh * 0.25) v = "bottom";
    if (dx > w * 0.25) g = "right";
    else if (dx < -w * 0.25) g = "left";
    string s = v;
    if (g != "") { if (s != "") s += "-"; s += g; }
    if (s == "") s = "center";
    return s;
}

// ключ стрелкой (не зависит от языка): куда смотреть от центра корпуса, вид на эту сторону
string key_arrow(int e)
{
    if (!el_has_p1[e]) return "";
    real cx = (el_bx1[e] + el_bx2[e]) / 2, cy = (el_by1[e] + el_by2[e]) / 2;
    real dx = el_p1x[e] - cx, dy = el_p1y[e] - cy;
    if (el_bottom[e]) dx = -dx;
    real w = (el_bx2[e] - el_bx1[e]) / 2, hh = (el_by2[e] - el_by1[e]) / 2;
    int v = 0, g = 0;
    if (dy > hh * 0.25) v = 1; else if (dy < -hh * 0.25) v = -1;
    if (dx > w * 0.25) g = 1; else if (dx < -w * 0.25) g = -1;
    if (v == 1 && g == -1) return "↖";
    if (v == 1 && g == 1) return "↗";
    if (v == -1 && g == -1) return "↙";
    if (v == -1 && g == 1) return "↘";
    if (v == 1) return "↑";
    if (v == -1) return "↓";
    if (g == -1) return "←";
    if (g == 1) return "→";
    return "•";
}

// нужен ли ключ на чертеже: микросхемы, транзисторы, диоды, светодиоды, полярные конденсаторы
int needs_key(int e)
{
    string p = des_prefix(el_name[e]);
    if (p == "R" || p == "RN" || p == "RA" || p == "L" || p == "FB" || p == "F" || p == "Y" || p == "X" || p == "J" || p == "S" || p == "SW") return 0;
    if (p == "C" && el_npads[e] <= 2) {
        // керамика — без ключа; электролит/тантал — по корпусу
        string j = strupr(el_jpkg[e]);
        if (strstr(j, "CASE-") >= 0) return 1;
        if (is_chip(el_jpkg[e])) return 0;          // керамика 0402…2512 — без полярности
        if (el_bx2[e] - el_bx1[e] > 4.5) return 1;
        return 0;
    }
    return 1;
}

// ---------------------------------------------------------------- сбор геометрии (контекст платы)

// отрезки контура для сборки замкнутой фигуры
real os_x1[], os_y1[], os_x2[], os_y2[], os_cv[];
int n_os = 0;

void outline_add(real x1, real y1, real x2, real y2, real curve)
{
    os_x1[n_os] = x1; os_y1[n_os] = y1; os_x2[n_os] = x2; os_y2[n_os] = y2; os_cv[n_os] = curve;
    n_os++;
    ol_path += seg_path(x1, y1, x2, y2, curve);
    bb_add(x1, y1);
    bb_add(x2, y2);
}

void outline_circle(real x, real y, real r)
{
    string t;
    sprintf(t, "<circle class=\"olc\" cx=\"%s\" cy=\"%s\" r=\"%s\"/>", f3(x), f3(y), f3(r));
    ol_circ += t;
}

// замкнутые контуры из отрезков (жадная сцепка концов), формат SVG path с Z
string outline_closed()
{
    int used[];
    int i, k, n_left = n_os;
    string d = "", seg;
    real tol = 0.02;
    for (i = 0; i < n_os; i++) used[i] = 0;
    while (n_left > 0) {
        int st = -1;
        for (i = 0; i < n_os; i++) if (!used[i]) { st = i; break; }
        if (st < 0) break;
        used[st] = 1; n_left--;
        real sx = os_x1[st], sy = os_y1[st], cx = os_x2[st], cy = os_y2[st];
        d += seg_path(os_x1[st], os_y1[st], os_x2[st], os_y2[st], os_cv[st]);
        int grow = 1;
        while (grow) {
            grow = 0;
            for (k = 0; k < n_os; k++) {
                if (used[k]) continue;
                if (abs(os_x1[k] - cx) < tol && abs(os_y1[k] - cy) < tol) {
                    seg = seg_path(os_x1[k], os_y1[k], os_x2[k], os_y2[k], os_cv[k]);
                    cx = os_x2[k]; cy = os_y2[k];
                } else if (abs(os_x2[k] - cx) < tol && abs(os_y2[k] - cy) < tol) {
                    seg = seg_path(os_x2[k], os_y2[k], os_x1[k], os_y1[k], -os_cv[k]);
                    cx = os_x1[k]; cy = os_y1[k];
                } else continue;
                // убрать начальное M: продолжаем ту же фигуру
                int pa = strstr(seg, "A"), pl = strstr(seg, "L");
                int cut = pl;
                if (pa >= 0 && (pl < 0 || pa < pl)) cut = pa;
                d += strsub(seg, cut);
                used[k] = 1; n_left--;
                grow = 1;
                break;
            }
        }
        if (abs(cx - sx) < tol && abs(cy - sy) < tol) d += "Z";
    }
    return d;
}

void collect_draw(int i, UL_ELEMENT E)
{
    el_draw_init(i);
    int lp = LAYER_TPLACE, ld = 51;
    if (el_bottom[i]) { lp = LAYER_BPLACE; ld = 52; }
    real x1, y1, x2, y2;
    E.footprint.wires(W) {
        x1 = u2mm(W.x1); y1 = u2mm(W.y1); x2 = u2mm(W.x2); y2 = u2mm(W.y2);
        if (W.layer == lp || W.layer == ld) {
            el_gfx[i] += seg_path(x1, y1, x2, y2, W.curve);
            el_bb_add(i, x1, y1);
            el_bb_add(i, x2, y2);
        } else if (W.layer == LAYER_DIMENSION) {
            outline_add(x1, y1, x2, y2, W.curve);
        }
    }
    E.footprint.circles(CI) {
        if (CI.layer == lp || CI.layer == ld) {
            string t;
            sprintf(t, "<circle class=\"gx\" cx=\"%s\" cy=\"%s\" r=\"%s\"/>", f3(u2mm(CI.x)), f3(u2mm(CI.y)), f3(u2mm(CI.radius)));
            el_circ[i] += t;
            el_bb_add(i, u2mm(CI.x) - u2mm(CI.radius), u2mm(CI.y) - u2mm(CI.radius));
            el_bb_add(i, u2mm(CI.x) + u2mm(CI.radius), u2mm(CI.y) + u2mm(CI.radius));
        } else if (CI.layer == LAYER_DIMENSION) {
            outline_circle(u2mm(CI.x), u2mm(CI.y), u2mm(CI.radius));
        }
    }
    E.footprint.rectangles(RC) {
        if (RC.layer == lp || RC.layer == ld) {
            real cx = u2mm(RC.x1 + RC.x2) / 2, cy = u2mm(RC.y1 + RC.y2) / 2;
            real w = u2mm(RC.x2 - RC.x1), hh = u2mm(RC.y2 - RC.y1);
            string t;
            sprintf(t, "<rect class=\"gx\" x=\"%s\" y=\"%s\" width=\"%s\" height=\"%s\" transform=\"translate(%s %s) rotate(%s)\"/>",
                    f3(-w / 2), f3(-hh / 2), f3(abs(w)), f3(abs(hh)), f3(cx), f3(cy), f3(RC.angle));
            el_circ[i] += t;
            el_bb_add(i, cx - abs(w) / 2, cy - abs(hh) / 2);
            el_bb_add(i, cx + abs(w) / 2, cy + abs(hh) / 2);
        }
    }
    // шаг и число выводов — по SMD-площадкам, если они есть (переходные отверстия теплоотвода
    // в QFN/DPAK — тоже «pad», но это не выводы); вывод 1: точное имя «1» главнее «P$1»
    real px[], py[], sx[], sy[];
    int np = 0, ns = 0, p1 = 0, kat = 0, p1rank = 0;
    E.footprint.contacts(C) {
        real x = u2mm(C.x), y = u2mm(C.y), w, hh, rot = 0;
        int rnd = 0;
        if (C.smd) {
            w = u2mm(C.smd.dx); hh = u2mm(C.smd.dy); rot = C.smd.angle;
            rnd = (C.smd.roundness >= 100 && C.smd.dx == C.smd.dy);
            sx[ns] = x; sy[ns] = y; ns++;
        } else {
            w = u2mm(C.pad.diameter[LAYER_TOP]);
            if (w <= 0) w = u2mm(C.pad.drill) * 1.6;
            hh = w; rnd = 1;
        }
        el_pads[i] += pad_svg(x, y, w, hh, rot, rnd);
        real r = max(w, hh) / 2;
        el_bb_add(i, x - r, y - r);
        el_bb_add(i, x + r, y + r);
        px[np] = x; py[np] = y; np++;
        if (is_cathode_name(C.name)) {
            el_p1x[i] = x; el_p1y[i] = y; kat = 1; p1 = 1;
        } else if (!kat) {
            int rk = 0;
            if (C.name == "1") { if (C.smd) rk = 4; else rk = 3; }
            else if (pin_norm(C.name) == "1") { if (C.smd) rk = 2; else rk = 1; }
            if (rk > p1rank) { el_p1x[i] = x; el_p1y[i] = y; p1 = 1; p1rank = rk; }
        }
    }
    if (ns >= 2) {
        np = ns;
        for (int q2 = 0; q2 < ns; q2++) { px[q2] = sx[q2]; py[q2] = sy[q2]; }
    }
    el_npads[i] = np;
    el_has_p1[i] = p1;
    el_p1cat[i] = kat;
    real best = 1000000.0;
    for (int a = 0; a < np; a++) {
        for (int b = a + 1; b < np; b++) {
            real dx = px[a] - px[b], dy = py[a] - py[b];
            real d = sqrt(dx * dx + dy * dy);
            if (d > 0.05 && d < best) best = d;
        }
    }
    if (best < 100000.0) el_pitch[i] = best;
    if (el_bx1[i] > el_bx2[i]) {
        el_bx1[i] = el_x[i] - 0.5; el_bx2[i] = el_x[i] + 0.5; el_by1[i] = el_y[i] - 0.5; el_by2[i] = el_y[i] + 0.5;
    }
}
