// ---------------------------------------------------------------- двуязычные строки

// для диалогов и простого текста: «Русский / English»
string L(string ru, string en)
{
    return ru + " / " + en;
}

// для HTML: русский основной, английский — подстрочником (класс en)
string hl(string ru, string en)
{
    return h(ru) + "<span class=\"en\">" + h(en) + "</span>";
}

// готовая разметка: не-ASCII символы -> числовые ссылки (теги и сущности не трогает)
string asc(string s)
{
    string t = "";
    int i = 0, from = 0;
    while (s[i]) {
        if (s[i] > 127) {
            if (i > from) t += strsub(s, from, i - from);
            string e;
            sprintf(e, "&#%d;", s[i]);
            t += e;
            from = i + 1;
        }
        i++;
    }
    if (from == 0) return s;
    if (i > from) t += strsub(s, from, i - from);
    return t;
}

// в одну строку через косую черту
string hs(string ru, string en)
{
    return h(ru) + " <span class=\"en1\">/ " + h(en) + "</span>";
}

// ---------------------------------------------------------------- файлы и команды

int file_exists(string p)
{
    string a[];
    return fileglob(a, p) > 0;
}

// команда Windows через cmd.exe; окно консоли мелькает — так и должно быть
int shell(string cmd)
{
    return system("cmd.exe /c " + cmd);
}

string qp(string p)
{
    return "\"" + to_win(p) + "\"";
}

string url_file(string p)
{
    string s = replace_all(p, "\\", "/");
    s = replace_all(s, " ", "%20");
    s = replace_all(s, "#", "%23");
    return "file:///" + s;
}

// ---------------------------------------------------------------- состояние между фазами (key=value)

string st_k[], st_v[];
int n_st = 0;

void st_set(string k, string v)
{
    for (int i = 0; i < n_st; i++) {
        if (st_k[i] == k) { st_v[i] = v; return; }
    }
    st_k[n_st] = k;
    st_v[n_st] = v;
    n_st++;
}

void st_seti(string k, int v)
{
    st_set(k, istr(v));
}

string st_get(string k)
{
    for (int i = 0; i < n_st; i++)
        if (st_k[i] == k) return st_v[i];
    return "";
}

int st_geti(string k)
{
    return strtol(st_get(k));
}

void st_save(string path)
{
    output(path, "wt") {
        for (int i = 0; i < n_st; i++) {
            string v = replace_all(st_v[i], "\n", "\\n");
            printf("%s=%s\n", st_k[i], h(v));
        }
    }
}

// значения пишутся через h(): так кириллица и спецсимволы переживают однобайтовую кодировку
string unh(string s)
{
    string t = "";
    int i = 0;
    while (s[i]) {
        if (s[i] == '&') {
            int e = strstr(s, ";", i);
            if (e > i) {
                string ent = strsub(s, i + 1, e - i - 1);
                if (ent == "amp") t += "&";
                else if (ent == "lt") t += "<";
                else if (ent == "gt") t += ">";
                else if (ent == "quot") t += "\"";
                else if (ent[0] == '#') {
                    char c = strtol(strsub(ent, 1));
                    t += c;
                } else t += "&" + ent + ";";
                i = e + 1;
                continue;
            }
        }
        t += s[i];
        i++;
    }
    return t;
}

void st_load(string path)
{
    string lines[];
    n_st = 0;
    if (!file_exists(path)) return;
    int n = fileread(lines, path);
    for (int i = 0; i < n; i++) {
        int p = strstr(lines[i], "=");
        if (p <= 0) continue;
        st_k[n_st] = strsub(lines[i], 0, p);
        st_v[n_st] = replace_all(unh(trim(strsub(lines[i], p + 1))), "\\n", "\n");
        n_st++;
    }
}

// ---------------------------------------------------------------- журнал хода работы (для отчёта)

string log_txt = "";

void fk_log(string s)
{
    log_txt += t2string(time(), "hh:mm:ss") + "  " + s + "\n";
    status(FK_NAME + ": " + s);
}
