string FK_DATE    = "2026-10-08";
string FK_AUTHOR  = "dmxON by AlexSmith";
string FK_YEAR    = "2026";
string FK_ID      = "dmxon_fabkit";       // префикс настроек в eaglerc
string FK_MARKER  = ".dmxon-fabkit";      // метка «эта папка создана FabKit» — только такую можно очищать

string fk_title()
{
    return FK_NAME + " v" + FK_VERSION;
}

string fk_sign()
{
    return FK_NAME + " v" + FK_VERSION + " · " + FK_AUTHOR + " " + FK_YEAR;
}

